# Copy this file to .env and replace the placeholders.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD_HERE@localhost:5432/documind_db

# Secret used to sign authentication JWT tokens.
# Generate a long random value for your actual .env file.
JWT_SECRET_KEY=YOUR_RANDOM_SECRET_HERE

# NVIDIA NIM API key, used by app/llm_service.py to generate RAG answers.
# Get one from https://build.nvidia.com/
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY_HERE